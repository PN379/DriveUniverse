<UserControl x:Class="DriveUniverse.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="30,26,30,26">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="SETTINGS" Style="{StaticResource TitleText}"/>
                <TextBlock Text="  /  preferences" Style="{StaticResource SubtitleText}" VerticalAlignment="Bottom" Margin="0,0,0,5"/>
            </StackPanel>

            <Border Style="{StaticResource GlassCard}" Margin="0,20,0,0">
                <StackPanel>
                    <TextBlock Text="AUDIO &amp; FX" Style="{StaticResource TinyLabel}" Margin="0,0,0,12"/>
                    <CheckBox x:Name="ChkSound" Content="UI sounds"/>
                    <CheckBox x:Name="ChkWarp" Content="Warp / space-travel transition" Margin="0,10,0,0" IsChecked="True"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource GlassCard}" Margin="0,14,0,0">
                <StackPanel>
                    <TextBlock Text="POWER-CYCLE DEFAULTS" Style="{StaticResource TinyLabel}" Margin="0,0,0,12"/>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Cycles:" Style="{StaticResource LabelNormal}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ComboBox x:Name="CmbCycles" Width="64"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <TextBlock Text="Delay:" Style="{StaticResource LabelNormal}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ComboBox x:Name="CmbDelay" Width="90"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource GlassCard}" Margin="0,14,0,0">
                <StackPanel>
                    <TextBlock Text="WINDOW" Style="{StaticResource TinyLabel}" Margin="0,0,0,12"/>
                    <CheckBox x:Name="ChkMini" Content="Launch in mini (tray) mode"/>
                    <CheckBox x:Name="ChkAutoStart" Content="Start DriveUniverse with Windows" Margin="0,10,0,0"/>
                    <CheckBox x:Name="ChkWidgetQuick" Content="Show quick actions on Orbit widget" Margin="0,10,0,0" IsChecked="True"/>
                    <Button x:Name="BtnDev" Style="{StaticResource GhostButton}" Content="⌨  Open Dev Console" Margin="0,12,0,0" Click="Dev_Click"/>
                    <Button x:Name="BtnSupport" Style="{StaticResource PrimaryButton}" Content="♥  Support DriveUniverse" Margin="0,10,0,0" Click="Support_Click"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource GlassCard}" Margin="0,14,0,0">
                <StackPanel>
                    <TextBlock Text="ABOUT" Style="{StaticResource TinyLabel}" Margin="0,0,0,6"/>
                    <TextBlock Text="DriveUniverse" Style="{StaticResource LabelBright}"/>
                    <TextBlock Text="v1.0.0 Beta" Style="{StaticResource LabelMuted}" Margin="0,2,0,0"/>
                    <TextBlock Text="Orbit your drives — eject, power-cycle, automate, and command by voice."
                               Style="{StaticResource LabelMuted}" Margin="0,10,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
