<UserControl x:Class="DriveUniverse.Views.VoiceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="18,10,18,14">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="VOICE" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextBright}"/>
                <TextBlock Text="  /  talk to Orbit" FontSize="12" Foreground="{StaticResource TextMuted}" VerticalAlignment="Bottom" Margin="0,0,0,4"/>
            </StackPanel>

            <Border Style="{StaticResource GlassCard}" Margin="0,12,0,0">
                <StackPanel>
                    <TextBlock x:Name="Status" Text="Checking..." Style="{StaticResource LabelMuted}" TextWrapping="Wrap"/>
                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                        <TextBlock Text="Language:" Style="{StaticResource LabelNormal}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ComboBox x:Name="CmbLanguage" Width="140"/>
                    </StackPanel>
                    <TextBlock Text="Note: changes the recognizer language. TTS follows your Windows Speech settings."
                               Style="{StaticResource LabelMuted}" FontSize="10" Margin="0,6,0,0" TextWrapping="Wrap"/>
                    <CheckBox x:Name="ChkEnable" Content="Enable voice" Margin="0,12,0,0"/>
                    <CheckBox x:Name="ChkAlways" Content="Always listening" Margin="0,10,0,0" IsEnabled="False"/>
                </StackPanel>
            </Border>

            <!-- ORBIT settings section -->
            <TextBlock Text="ORBIT" Style="{StaticResource TinyLabel}" Margin="0,16,0,6"/>
            <Border Style="{StaticResource GlassCard}">
                <StackPanel>
                    <CheckBox x:Name="ChkWakeWord" Content="Require wake word" Margin="0,0,0,0" IsChecked="True" ToolTip="Say 'Orbit' before commands to prevent false triggers"/>
                    <TextBlock Text="When ON: say 'Orbit' then your command within 8 seconds." Style="{StaticResource LabelMuted}" Margin="28,4,0,0" FontSize="10"/>
                    <CheckBox x:Name="ChkWidgetQuick" Content="Quick actions on widget" Margin="0,10,0,0" IsChecked="True"/>
                </StackPanel>
            </Border>

            <!-- PTT + Diagnostics -->
            <Border Style="{StaticResource GlassCard}" Margin="0,10,0,0">
                <StackPanel>
                    <Button x:Name="BtnPTT" Style="{StaticResource PrimaryButton}" Content="Hold to talk (bypasses wake word)" Padding="14,7"/>
                    <Button x:Name="BtnDiag" Style="{StaticResource GhostButton}" Content="Diagnostics" Padding="14,7" Margin="0,8,0,0" Click="Diag_Click"/>
                </StackPanel>
            </Border>

            <Border x:Name="DiagPanel" Style="{StaticResource GlassCard}" Margin="0,10,0,0" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Text="DIAGNOSTICS" Style="{StaticResource TinyLabel}" Margin="0,0,0,8"/>
                    <TextBox x:Name="DiagOutput" FontFamily="Consolas" FontSize="11" Background="Transparent"
                             BorderThickness="0" Foreground="#FF8AE0A8" IsReadOnly="True" TextWrapping="Wrap"
                             MaxHeight="200" VerticalScrollBarVisibility="Auto"/>
                </StackPanel>
            </Border>

            <TextBlock Text="WHAT YOU CAN SAY" Style="{StaticResource TinyLabel}" Margin="0,16,0,6"/>
            <ItemsControl>
                <ItemsControl.Resources>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{StaticResource TextNormal}"/>
                        <Setter Property="FontSize" Value="12"/>
                        <Setter Property="Margin" Value="0,3"/>
                    </Style>
                </ItemsControl.Resources>
                <TextBlock Text="1. Say 'Orbit' (wake word)"/>
                <TextBlock Text="2. 'Eject drive' / 'Connect drive'"/>
                <TextBlock Text="3. 'Open Defraggler' (linked apps)"/>
                <TextBlock Text="4. 'Drive status'"/>
                <TextBlock Text="5. 'Yes' / 'No' (confirm eject)"/>
                <TextBlock Text="6. 'Help' / 'What can you do'"/>
            </ItemsControl>

            <TextBlock Text="Runs fully offline - no audio leaves your PC."
                       Style="{StaticResource LabelMuted}" Margin="0,14,0,0" TextWrapping="Wrap" FontSize="11"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
