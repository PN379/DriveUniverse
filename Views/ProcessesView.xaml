<UserControl x:Class="DriveUniverse.Views.ProcessesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVis"/>
    </UserControl.Resources>
    <Grid Margin="18,10,18,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Orientation="Horizontal">
            <TextBlock Text="PROCESSES" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextBright}"/>
            <TextBlock Text="  /  who's holding the drive" FontSize="12" Foreground="{StaticResource TextMuted}" VerticalAlignment="Bottom" Margin="0,0,0,4"/>
        </StackPanel>

        <DockPanel Grid.Row="1" Margin="0,12,0,0">
            <Button x:Name="BtnAutoQuit" Style="{StaticResource GhostButton}" Content="✕ Auto-quit" DockPanel.Dock="Right" Padding="12,7" Click="AutoQuit_Click"/>
            <Button x:Name="BtnScan" Style="{StaticResource GhostButton}" Content="↻ Scan" DockPanel.Dock="Right" Padding="12,7" Margin="0,0,6,0" Click="Scan_Click"/>
            <TextBlock x:Name="DriveLbl" Style="{StaticResource LabelMuted}" VerticalAlignment="Center"/>
        </DockPanel>

        <Grid Grid.Row="2" Margin="0,10,0,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="List">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource GlassCard}" Margin="0,0,0,8" Padding="14,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="32" Height="32" CornerRadius="9" Background="#288E70FF" Margin="0,0,12,0">
                                        <TextBlock Text="⚙" Foreground="{StaticResource CyanGlow}" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding AppName}" Foreground="{StaticResource TextBright}" FontWeight="SemiBold" FontSize="13"/>
                                            <Border Margin="6,0,0,0" Padding="5,1" CornerRadius="4" Background="#33FF7088"
                                                    Visibility="{Binding Recurring, Converter={StaticResource BoolVis}}" VerticalAlignment="Center">
                                                <TextBlock Text="RECURRING" FontSize="8" Foreground="{StaticResource RedGlow}" FontWeight="Bold"/>
                                            </Border>
                                        </StackPanel>
                                        <TextBlock FontSize="10" Foreground="{StaticResource TextMuted}" Margin="0,1,0,0">
                                            <Run Text="PID "/><Run Text="{Binding Pid}"/>
                                        </TextBlock>
                                        <TextBlock Text="{Binding ExePath}" FontSize="9" Foreground="#555B6C8C" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Style="{StaticResource GhostButton}" Content="★" Padding="8,5" FontSize="11" Margin="0,0,4,0" Click="Whitelist_Click" Tag="{Binding}" ToolTip="Whitelist"/>
                                        <Button Style="{StaticResource PrimaryButton}" Content="End" Padding="10,5" FontSize="11" Click="Terminate_Click" Tag="{Binding}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            <TextBlock x:Name="Empty" Text="✦ Drive is clear — nothing holding it open." Style="{StaticResource LabelMuted}" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Grid>
    </Grid>
</UserControl>
