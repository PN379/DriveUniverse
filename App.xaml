<Application x:Class="DriveUniverse.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>

        <!-- ===== Deep-space palette ===== -->
        <SolidColorBrush x:Key="BgDeep"      Color="#FF05080F"/>
        <SolidColorBrush x:Key="BgPanel"     Color="#FF0D121F"/>
        <SolidColorBrush x:Key="BgPanelHi"   Color="#FF141B2E"/>
        <SolidColorBrush x:Key="BgCard"      Color="#E8101626"/>
        <SolidColorBrush x:Key="BorderBrush"  Color="#FF2A3454"/>
        <SolidColorBrush x:Key="BorderHi"     Color="#FF3D4D7A"/>
        <SolidColorBrush x:Key="TextBright"   Color="#FFF4F7FF"/>
        <SolidColorBrush x:Key="TextNormal"   Color="#FFC8D0E6"/>
        <SolidColorBrush x:Key="TextMuted"    Color="#FF7B88A8"/>
        <SolidColorBrush x:Key="CyanGlow"     Color="#FF45E7F7"/>
        <SolidColorBrush x:Key="PurpleGlow"   Color="#FF8E70FF"/>
        <SolidColorBrush x:Key="WarmGlow"     Color="#FFFDC55E"/>
        <SolidColorBrush x:Key="GreenGlow"    Color="#FF58ED9D"/>
        <SolidColorBrush x:Key="RedGlow"      Color="#FFFF7088"/>
        <SolidColorBrush x:Key="AccentGrad1"  Color="#FF45E7F7"/>
        <SolidColorBrush x:Key="AccentGrad2"  Color="#FF8E70FF"/>

        <!-- Backward-compatible aliases (older views reference these names) -->
        <SolidColorBrush x:Key="TextBrush"    Color="#FFF4F7FF"/>
        <SolidColorBrush x:Key="MutedBrush"   Color="#FF7B88A8"/>
        <SolidColorBrush x:Key="CyanBrush"    Color="#FF45E7F7"/>
        <SolidColorBrush x:Key="PurpleBrush"  Color="#FF8E70FF"/>
        <SolidColorBrush x:Key="WarmBrush"    Color="#FFFDC55E"/>
        <SolidColorBrush x:Key="GreenBrush"   Color="#FF58ED9D"/>
        <SolidColorBrush x:Key="RedBrush"     Color="#FFFF7088"/>
        <SolidColorBrush x:Key="PanelBrush"   Color="#FF0D121F"/>
        <SolidColorBrush x:Key="PanelHiBrush" Color="#FF141B2E"/>
        <SolidColorBrush x:Key="StrokeBrush"  Color="#FF2A3454"/>
        <SolidColorBrush x:Key="SpaceBgBrush" Color="#FF05080F"/>

        <!-- Color resources (referenced by Color="{StaticResource ...}") -->
        <Color x:Key="Panel">#FF0D121F</Color>
        <Color x:Key="PanelHi">#FF141B2E</Color>
        <Color x:Key="Stroke">#FF2A3454</Color>
        <Color x:Key="Text">#FFF4F7FF</Color>
        <Color x:Key="Muted">#FF7B88A8</Color>
        <Color x:Key="Cyan">#FF45E7F7</Color>
        <Color x:Key="Purple">#FF8E70FF</Color>
        <Color x:Key="Warm">#FFFDC55E</Color>
        <Color x:Key="Green">#FF58ED9D</Color>
        <Color x:Key="Red">#FFFF7088</Color>

        <!-- ===== Glass card style (panels, status cards) ===== -->
        <Style x:Key="GlassCard" TargetType="Border">
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="20,16"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#CC131B30" Offset="0"/>
                        <GradientStop Color="#990C1018" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#22000000" BlurRadius="22" ShadowDepth="4" Opacity="0.5"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== TextBlocks ===== -->
        <Style x:Key="TitleText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextBright}"/>
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
        <Style x:Key="SubtitleText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style x:Key="LabelBright" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextBright}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="LabelNormal" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextNormal}"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style x:Key="LabelMuted" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style x:Key="TinyLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <!-- ===== Primary action button (gradient + glow) ===== -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Foreground" Value="#FF04080F"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="12" BorderThickness="0">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop x:Name="gs1" Color="#FF45E7F7" Offset="0"/>
                                    <GradientStop x:Name="gs2" Color="#FF8E70FF" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Border.Effect>
                                <DropShadowEffect x:Name="glow" Color="#FF45E7F7" BlurRadius="0" ShadowDepth="0" Opacity="0"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="glow" Storyboard.TargetProperty="BlurRadius" To="20" Duration="0:0:0.2"/>
                                            <DoubleAnimation Storyboard.TargetName="glow" Storyboard.TargetProperty="Opacity" To="0.7" Duration="0:0:0.2"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="glow" Storyboard.TargetProperty="BlurRadius" To="0" Duration="0:0:0.2"/>
                                            <DoubleAnimation Storyboard.TargetName="glow" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="RenderTransform">
                                    <Setter.Value><ScaleTransform ScaleX="0.97" ScaleY="0.97"/></Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== Ghost / secondary button ===== -->
        <Style x:Key="GhostButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextNormal}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="18,9"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="12" BorderThickness="1.2" BorderBrush="{StaticResource BorderBrush}">
                            <Border.Background>
                                <SolidColorBrush Color="#30101A2E"/>
                            </Border.Background>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ColorAnimation Storyboard.TargetName="bd" Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)" To="#FF45E7F7" Duration="0:0:0.2"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ColorAnimation Storyboard.TargetName="bd" Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)" To="#FF2A3454" Duration="0:0:0.2"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== Navigation icon button (compact bottom bar) ===== -->
        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="bg" CornerRadius="10" Background="Transparent"/>
                            <Border x:Name="dot" Width="4" Height="4" CornerRadius="2" Background="{StaticResource CyanGlow}" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,4" Opacity="0"/>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background">
                                    <Setter.Value><SolidColorBrush Color="#20141B30"/></Setter.Value>
                                </Setter>
                                <Setter Property="Foreground" Value="{StaticResource TextNormal}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== DARK ComboBox (the big contrast fix) ===== -->
        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="{StaticResource TextBright}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <!-- toggle button (invisible, fills entire area, opens/closes dropdown) -->
                            <ToggleButton x:Name="toggleButton" Focusable="False" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" ClickMode="Press">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="Transparent"/>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Border x:Name="bd" CornerRadius="10" BorderThickness="1.2" BorderBrush="{StaticResource BorderBrush}" Background="{StaticResource BgPanel}" IsHitTestVisible="False">
                                <Grid>
                                    <ContentPresenter ContentSource="SelectionBoxItem" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="12,0,0,0"/>
                                    <TextBlock Text="▾" Foreground="{StaticResource CyanGlow}" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                </Grid>
                            </Border>
                            <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" PopupAnimation="Fade" MinWidth="{TemplateBinding ActualWidth}">
                                <Border CornerRadius="10" BorderThickness="1" BorderBrush="{StaticResource BorderHi}" Background="{StaticResource BgPanel}" Padding="4" MaxHeight="300">
                                    <Border.Effect>
                                        <DropShadowEffect Color="#40000000" BlurRadius="16" ShadowDepth="4" Opacity="0.6"/>
                                    </Border.Effect>
                                    <ScrollViewer x:Name="PART_ScrollViewer" VerticalScrollBarVisibility="Auto">
                                        <StackPanel IsItemsHost="True"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource CyanGlow}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ComboBox items in dropdown -->
        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{StaticResource TextNormal}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="bd" CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background">
                                    <Setter.Value><SolidColorBrush Color="#2845E7F7"/></Setter.Value>
                                </Setter>
                                <Setter Property="Foreground" Value="{StaticResource TextBright}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="Background">
                                    <Setter.Value><SolidColorBrush Color="#2045E7F7"/></Setter.Value>
                                </Setter>
                                <Setter Property="Foreground" Value="{StaticResource TextBright}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== Dark CheckBox ===== -->
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextBright}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border x:Name="box" Width="22" Height="22" CornerRadius="6" BorderThickness="1.5" BorderBrush="{StaticResource BorderHi}" Background="{StaticResource BgPanel}" VerticalAlignment="Center">
                                <TextBlock x:Name="check" Text="✓" FontSize="14" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0"/>
                            </Border>
                            <ContentPresenter VerticalAlignment="Center" Margin="10,0,0,0"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="check" Property="Opacity" Value="1"/>
                                <Setter TargetName="box" Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#FF45E7F7" Offset="0"/>
                                            <GradientStop Color="#FF8E70FF" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="box" Property="BorderBrush" Value="{StaticResource CyanGlow}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="box" Property="BorderBrush" Value="{StaticResource CyanGlow}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== Dark TextBox ===== -->
        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="{StaticResource TextBright}"/>
            <Setter Property="Background" Value="{StaticResource BgPanel}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1.2"/>
            <Setter Property="CaretBrush" Value="{StaticResource CyanGlow}"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border CornerRadius="8" BorderThickness="{TemplateBinding BorderThickness}" BorderBrush="{TemplateBinding BorderBrush}" Background="{TemplateBinding Background}">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== Dark ScrollViewer + ScrollBar (no white scrollbars) ===== -->
        <Style TargetType="ScrollViewer">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollViewer">
                        <Grid Background="Transparent">
                            <ScrollContentPresenter/>
                            <ScrollBar x:Name="PART_VerticalScrollBar" HorizontalAlignment="Right"
                                       Orientation="Vertical" Width="8" Background="Transparent"
                                       Maximum="{TemplateBinding ScrollableHeight}" ViewportSize="{TemplateBinding ViewportHeight}"
                                       Value="{TemplateBinding VerticalOffset}" Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"/>
                            <ScrollBar x:Name="PART_HorizontalScrollBar" VerticalAlignment="Bottom"
                                       Orientation="Horizontal" Height="8" Background="Transparent"
                                       Maximum="{TemplateBinding ScrollableWidth}" ViewportSize="{TemplateBinding ViewportWidth}"
                                       Value="{TemplateBinding HorizontalOffset}" Visibility="{TemplateBinding ComputedHorizontalScrollBarVisibility}"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid>
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border CornerRadius="4" Margin="1">
                                                    <Border.Background>
                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                            <GradientStop Color="#6645E7F7" Offset="0"/>
                                                            <GradientStop Color="#668E70FF" Offset="1"/>
                                                        </LinearGradientBrush>
                                                    </Border.Background>
                                                </Border>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== ToolTip ===== -->
        <Style TargetType="ToolTip">
            <Setter Property="Background" Value="#FF0D121F"/>
            <Setter Property="Foreground" Value="#FFC8D0E6"/>
            <Setter Property="BorderBrush" Value="#FF2A3454"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>

    </Application.Resources>
</Application>
