<UserControl x:Class="DriveUniverse.Controls.VoiceConfirmSheet"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Opacity="0" IsHitTestVisible="False">
    <Border x:Name="Card" CornerRadius="14" Padding="18,14" MinWidth="240" HorizontalAlignment="Center"
            BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1">
        <Border.Background>
            <SolidColorBrush Color="{StaticResource Panel}" Opacity="0.96"/>
        </Border.Background>
        <Border.Effect>
            <DropShadowEffect Color="#66000000" BlurRadius="20" ShadowDepth="4" Opacity="0.6"/>
        </Border.Effect>
        <StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock Text="🎙" Foreground="{StaticResource CyanBrush}" FontSize="16" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBlock Text="You said" Foreground="{StaticResource MutedBrush}" FontSize="11" VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock x:Name="Heard" Text="—" Foreground="{StaticResource TextBrush}" FontSize="15" FontWeight="SemiBold"
                       HorizontalAlignment="Center" Margin="0,6,0,0" TextAlignment="Center" TextWrapping="Wrap"/>
            <TextBlock x:Name="Action" Text="" Foreground="{StaticResource CyanBrush}" FontSize="12"
                       HorizontalAlignment="Center" Margin="0,8,0,0" TextAlignment="Center" TextWrapping="Wrap"/>
            <StackPanel x:Name="ConfirmRow" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,0" Visibility="Collapsed">
                <Button x:Name="BtnYes" Style="{StaticResource PrimaryButton}" Content="Yes, do it" Padding="14,5" FontSize="11" Click="Yes_Click"/>
                <Button x:Name="BtnNo" Style="{StaticResource GhostButton}" Content="Cancel" Padding="12,5" FontSize="11" Margin="10,0,0,0" Click="No_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
