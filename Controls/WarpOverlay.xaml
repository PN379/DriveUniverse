<UserControl x:Class="DriveUniverse.Controls.WarpOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#FF070A14" Opacity="0" IsHitTestVisible="False">
    <Grid x:Name="Root">
        <!-- streaks canvas -->
        <Canvas x:Name="Streaks" ClipToBounds="True"/>

        <!-- the "drive planet" that detaches and floats into the void (eject cinema) -->
        <Grid x:Name="World" Width="220" Height="220" HorizontalAlignment="Center" VerticalAlignment="Center"
              RenderTransformOrigin="0.5,0.5" Opacity="1">
            <Grid.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="WorldScale" ScaleX="1" ScaleY="1"/>
                    <TranslateTransform x:Name="WorldTranslate" X="0" Y="0"/>
                </TransformGroup>
            </Grid.RenderTransform>
            <!-- orbit ring -->
            <Ellipse Width="280" Height="100" Stroke="#5545E7F7" StrokeThickness="2.5" Opacity="0.4">
                <Ellipse.RenderTransform>
                    <RotateTransform x:Name="WorldRing" Angle="-18" CenterX="110" CenterY="110"/>
                </Ellipse.RenderTransform>
            </Ellipse>
            <!-- planet sphere -->
            <Ellipse x:Name="WorldOrb">
                <Ellipse.Fill>
                    <RadialGradientBrush GradientOrigin="0.35,0.3">
                        <GradientStop Color="#FF6BEAF8" Offset="0"/>
                        <GradientStop Color="#FF35A0D8" Offset="0.35"/>
                        <GradientStop Color="#FF1E5FA8" Offset="0.65"/>
                        <GradientStop Color="#FF0E2848" Offset="0.92"/>
                        <GradientStop Color="#FF081830" Offset="1"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
                <Ellipse.Effect>
                    <DropShadowEffect x:Name="WorldGlow" Color="#FF45E7F7" BlurRadius="40" ShadowDepth="0" Opacity="0.6"/>
                </Ellipse.Effect>
            </Ellipse>
            <!-- warm accent glow -->
            <Ellipse Width="60" Height="60" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,20,20,0" Opacity="0.15">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#FFFDC55E" Offset="0"/>
                        <GradientStop Color="#00FDC55E" Offset="1"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
            <!-- specular highlight -->
            <Ellipse Width="40" Height="28" Fill="#33FFFFFF" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="40,40,0,0">
                <Ellipse.RenderTransform>
                    <SkewTransform AngleX="-20"/>
                </Ellipse.RenderTransform>
            </Ellipse>
        </Grid>

        <!-- label -->
        <TextBlock x:Name="Label" Text="" Foreground="#FF45E7F7" FontSize="16" FontWeight="Bold"
                   HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0">
            <TextBlock.Effect><DropShadowEffect Color="#FF45E7F7" BlurRadius="16" ShadowDepth="0"/></TextBlock.Effect>
        </TextBlock>

        <!-- particle trail canvas (for eject cinema) -->
        <Canvas x:Name="Particles" ClipToBounds="True"/>
    </Grid>
</UserControl>
