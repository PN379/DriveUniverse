<Window x:Class="DriveUniverse.CommandHelp"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctrl="clr-namespace:DriveUniverse.Controls"
        Title="DriveUniverse Commands" Width="420" Height="600"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True" ResizeMode="NoResize">
    <Border CornerRadius="18" BorderThickness="1.5" BorderBrush="#FF1A2138" MouseLeftButtonDown="Drag">
        <Border.Background>
            <SolidColorBrush Color="#F0050810"/>
        </Border.Background>
        <Grid>
            <ctrl:Starfield x:Name="Stars" IsHitTestVisible="False"/>

            <ScrollViewer Margin="0,20,0,50" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="24,10,24,10">

                    <!-- Header -->
                    <ctrl:LogoTitle HorizontalAlignment="Center" Margin="0,0,0,16"/>

                    <!-- Wake word -->
                    <Border CornerRadius="12" Background="#221A2440" Padding="16,12" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="WAKE WORD" FontSize="10" Foreground="#FFFDC55E" FontWeight="Bold" Margin="0,0,0,8"/>
                            <TextBlock Text="Orbit" FontSize="18" Foreground="#FF45E7F7" FontWeight="Bold"/>
                            <TextBlock Text="Say this first, then your command within 8 seconds." FontSize="11" Foreground="#FF7B88A8" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Drive commands -->
                    <TextBlock Text="DRIVE" FontSize="10" Foreground="#FF7B88A8" FontWeight="Bold" Margin="0,8,0,6"/>
                    <ItemsControl>
                        <ItemsControl.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="8"/>
                                <Setter Property="Background" Value="#18141B30"/>
                                <Setter Property="Padding" Value="14,8"/>
                                <Setter Property="Margin" Value="0,0,0,4"/>
                            </Style>
                        </ItemsControl.Resources>
                        <Border>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⏏" FontSize="16" Foreground="#FF45E7F7" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                <StackPanel>
                                    <TextBlock Text="eject / eject drive" FontSize="13" Foreground="#FFF4F7FF" FontWeight="SemiBold"/>
                                    <TextBlock Text="Ejects the drive (asks confirmation)" FontSize="10" Foreground="#FF7B88A8"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <Border>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⚡" FontSize="16" Foreground="#FF8E70FF" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                <StackPanel>
                                    <TextBlock Text="connect / mount / spin up" FontSize="13" Foreground="#FFF4F7FF" FontWeight="SemiBold"/>
                                    <TextBlock Text="Wakes / power-cycles the drive back on" FontSize="10" Foreground="#FF7B88A8"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <Border>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="❓" FontSize="16" Foreground="#FF58ED9D" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                <StackPanel>
                                    <TextBlock Text="drive status" FontSize="13" Foreground="#FFF4F7FF" FontWeight="SemiBold"/>
                                    <TextBlock Text="Reports the current drive state" FontSize="10" Foreground="#FF7B88A8"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </ItemsControl>

                    <!-- Apps -->
                    <TextBlock Text="APPS" FontSize="10" Foreground="#FF7B88A8" FontWeight="Bold" Margin="0,12,0,6"/>
                    <Border CornerRadius="8" Background="#18141B30" Padding="14,8" Margin="0,0,0,4">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⊞" FontSize="16" Foreground="#FFFDC55E" Margin="0,0,12,0" VerticalAlignment="Center"/>
                            <StackPanel>
                                <TextBlock Text="open [app name]" FontSize="13" Foreground="#FFF4F7FF" FontWeight="SemiBold"/>
                                <TextBlock Text="Launches a linked app (e.g. 'open Defraggler')" FontSize="10" Foreground="#FF7B88A8"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Confirmation -->
                    <TextBlock Text="CONFIRMATION" FontSize="10" Foreground="#FF7B88A8" FontWeight="Bold" Margin="0,12,0,6"/>
                    <Border CornerRadius="8" Background="#18141B30" Padding="14,8" Margin="0,0,0,4">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="✓" FontSize="16" Foreground="#FF58ED9D" Margin="0,0,12,0" VerticalAlignment="Center"/>
                            <StackPanel>
                                <TextBlock Text="yes / confirm / affirmative" FontSize="13" Foreground="#FFF4F7FF" FontWeight="SemiBold"/>
                                <TextBlock Text="Confirms eject request" FontSize="10" Foreground="#FF7B88A8"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Border CornerRadius="8" Background="#18141B30" Padding="14,8" Margin="0,0,0,4">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="✕" FontSize="16" Foreground="#FFFF7088" Margin="0,0,12,0" VerticalAlignment="Center"/>
                            <StackPanel>
                                <TextBlock Text="no / cancel / stop" FontSize="13" Foreground="#FFF4F7FF" FontWeight="SemiBold"/>
                                <TextBlock Text="Cancels eject request" FontSize="10" Foreground="#FF7B88A8"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="Tip: You can also use the quick buttons on the Orbit widget or the buttons in the app."
                               FontSize="10" Foreground="#FF5B6C8C" Margin="0,16,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </ScrollViewer>

            <!-- Close button -->
            <Button Content="✕" Width="34" Height="30" HorizontalAlignment="Right" VerticalAlignment="Top"
                    Margin="0,10,10,0" Click="Close_Click" Cursor="Hand" FontSize="14" Foreground="#FF7B88A8">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="8" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#CCFF7088"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </Grid>
    </Border>
</Window>
